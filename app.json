        "NSSpeechRecognitionUsageDescription": "يستخدم التطبيق التعرف على الكلام لإصدار التنبيهات الصوتية"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.parentcontrol.tifliwahtifi",
      "permissions": ["VIBRATE"]
    },
    "plugins": []
  }
}
