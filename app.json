{
  "expo": {
    "name": "طفلي وهاتفي",
    "slug": "tifli-wa-hatifi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1a1a2e"
